# ==============================================================================
# ShopRank Environment Variables Configuration Template
# Copy this file to .env and populate with your environment-specific credentials.
# Note: .env is git-ignored and must never be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DagsHub & MLflow Tracking Credentials (Phase 1 & 2)
# ------------------------------------------------------------------------------
DAGSHUB_USER=your_dagshub_username
DAGSHUB_TOKEN=your_dagshub_token
MLFLOW_TRACKING_URI=https://dagshub.com/your_dagshub_username/shoprank.mlflow

# ------------------------------------------------------------------------------
# 2. Online Feature Store & Redis Configuration
# ------------------------------------------------------------------------------
# In local development without Redis, set to "disabled" to use in-memory store.
# In Docker Compose, this is automatically set to redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Model Serving Configuration (FastAPI)
# ------------------------------------------------------------------------------
MODEL_DIR=models
MODEL_VERSION=v0.1.0
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 4. Traffic Router & Canary Rollout Configuration
# ------------------------------------------------------------------------------
CHAMPION_URL=http://localhost:8000
CHALLENGER_URL=http://localhost:8001
# Canary traffic percentage routed to Challenger [0 - 100]
CANARY_WEIGHT=0
# Mirror Champion traffic asynchronously to Challenger
SHADOW_ENABLED=true
# Salt for deterministic sticky user assignment
CANARY_SALT=shoprank-canary-2026
# Automated rollback triggers
MAX_ERROR_RATE=0.01
MAX_P95_LATENCY_MS=30.0
MIN_SAMPLE_SIZE=50

# ------------------------------------------------------------------------------
# 5. Drift Monitoring & Airflow Retraining Triggers
# ------------------------------------------------------------------------------
AIRFLOW_API_URL=http://localhost:8080/api/v1/dags/shoprank_retrain/dagRuns
DRIFT_COOLDOWN_SECONDS=21600
DRIFT_PSI_THRESHOLD=0.25
DRIFT_KS_THRESHOLD=0.08
