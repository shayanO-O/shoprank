      "title": "Candidate Generation & Pipeline Health",
      "type": "row"
    },
    {
      "title": "Stage 1 Retrieved Candidates Distribution",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 18 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(shoprank_retrieved_candidates_count_bucket{model_version=~\"$model_version\"}[1m])) by (le))",
          "legendFormat": "Median Candidates Retrieved",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "title": "Final Recommendations Post-Business Rules",
      "type": "timeseries",
